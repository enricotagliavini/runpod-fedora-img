#!/bin/bash
# Mock nvidia-smi for containerized environments
# Simulates an NVIDIA RTX 4090 with 24 GB VRAM

NVIDIA_SMI_OUTPUT="/tmp/nvidia-smi.mock"

# Generate mock output on first run or if file is empty
if [[ ! -f "$NVIDIA_SMI_OUTPUT" ]] || [[ ! -s "$NVIDIA_SMI_OUTPUT" ]]; then
    cat > "$NVIDIA_SMI_OUTPUT" << 'EOF'
+-----------------------------------------------------------------------------+
| NVIDIA-SMI 565.32       Driver Version: 565.32       CUDA Version: 12.3     |
|-----------------------------------------+----------------------+----------------------+
| GPU  Name                 Driver-Ver    | Bus-Id        Disp.A | Volatile Uncorr. ECC |
| Fan  Temp   Perf          Pwr:Usage/Cap |         Memory-Usage | GPU-Util  Compute M. |
|                                         |                      |               MIG M. |
|=========================================+======================+======================|
|   0  NVIDIA GeForce RTX 4090   565.32   | 00000000:00:1B.0  On |                  N/A |
|  0%   45C    P8              38W / 450W |      256MiB / 24576MiB |     30%      Default |
|                                         |                      |                  N/A |
+-----------------------------------------+----------------------+----------------------+
EOF

    cat >> "$NVIDIA_SMI_OUTPUT" << 'EOF'

+-----------------------------------------------------------------------------+
| Processes:                                                                                                                                                               |
|  GPU   GI   CI        PID   Type   Process name                              GPU Memory |
|        ID   ID                                                               Usage      |
|=============================================================================|
|    0   N/A  N/A         0      G   /usr/lib/xorg/Xorg                                         256MiB |
|    0   N/A  N/A         0      G   /usr/bin/gnome-shell                                       120MiB |
EOF

    echo "24576" > "${NVIDIA_SMI_OUTPUT}.mb"  # Store raw MB for easy access
fi

# Common queries
query_gpu_count() {
    grep -oP '^  [0-9]+ ' "$NVIDIA_SMI_OUTPUT" | head -1 | grep -oP '^[0-9]+'
}

query_gpu_name() {
    grep -oP '^\s+[0-9]+ [A-Za-z0-9 ]+' "$NVIDIA_SMI_OUTPUT" | head -1 | sed 's/^[0-9]* //'
}

query_memory_usage_mb() {
    grep -oP 'Memory-Usage \| \K[0-9]+' "$NVIDIA_SMI_OUTPUT"
}

# Wrapper for --query-gpu=count --format=csv
csv_count() {
    query_gpu_count
}

# Wrapper for --query-gpu=name --format=csv
csv_name() {
    query_gpu_name
}

# Wrapper for --query-gpu=memory.total --format=csv
csv_memory_total() {
    cat "${NVIDIA_SMI_OUTPUT}.mb"
}

case "${1:-}" in
    --query-gpu=count)
        echo "$(csv_count)"
        ;;
    --query-gpu=name)
        echo "$(csv_name)"
        ;;
    --query-gpu=memory.total)
        echo "$(csv_memory_total)"
        ;;
    --query-gpu=memory.used)
        echo "$(csv_memory_usage_mb)"
        ;;
    --format=csv)
        shift
        csv_count
        ;;
    --query-compute-apps=pid)
        echo "0"
        ;;
    --query-compute-apps=process_name)
        echo "/usr/lib/xorg/Xorg"
        ;;
    *)
        cat "$NVIDIA_SMI_OUTPUT"
        ;;
esac
